---
interface Props {
  title?: string;
}

const { title = 'Prompt Library' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
